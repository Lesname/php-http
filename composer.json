{
  "name": "lesname/http",
  "license": "MIT",
  "require": {
    "php": "^8.5.0",
    "ext-ctype": "*",

    "psr/container": "^2.0.0",
    "psr/simple-cache": "^3.0.0",
    "psr/http-server-middleware": "^1.0.0",
    "psr/http-factory": "^1.0.0",
    "psr/log": "^3.0.0",

    "symfony/translation-contracts": "^3.0.0"
  },
  "require-dev": {
    "ext-intl": "*",

    "lesname/token": "^0.4.0",
    "lesname/documentor": "^0.7.2",
    "lesname/validator": "^0.6.0",

    "doctrine/dbal": "^4.0.0",

    "squizlabs/php_codesniffer": "^4.0.0",
    "phpunit/phpunit": "^13.0.0",

    "vimeo/psalm": "^7.0.0-beta19",

    "phpstan/phpstan": "^2.0.0",
    "phpstan/extension-installer": "^1.4.0",
    "phpstan/phpstan-deprecation-rules": "^2.0.0"
  },
  "autoload": {
    "psr-4": {
      "LesHttp\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "LesHttpTest\\": "test/"
    }
  },
  "config": {
    "allow-plugins": {
      "phpstan/extension-installer": true
    }
  }
}
